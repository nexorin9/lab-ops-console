# ============================================================
# lab-ops-console 环境变量示例
# 用法：cp .env.example .env 后按院内实际情况填写
# ⚠️ .env 已在 .gitignore 中排除，禁止提交到 Git；
#    所有凭据只从环境变量读取，代码中不得硬编码。
# ============================================================

# ---------- 仪器入站（HL7 v2 / ASTM E1394 / 串口 / 厂商私有协议）----------
# HL7 v2 TCP 监听端口：仪器把报文推到本机此端口。必填。
DEVICE_LISTEN_PORT=2575
# 帧编码：utf-8 / gbk / gb18030。国内厂商仪器常为 gbk，解析层会做编码探测兜底。
DEVICE_ENCODING=utf-8
# 串口设备路径（USB 接入的仪器）。未接串口可留空。
SERIAL_PORT=
# 串口波特率。
SERIAL_BAUD_RATE=9600

# ---------- 院内 LIS FHIR 出站（写 Observation / DiagnosticReport / Specimen / Device）----------
# 院内 LIS 的 FHIR R4 服务地址。必填。
LIS_FHIR_BASE_URL=https://lis-fhir.example-hospital.internal/fhir/R4
# 访问 LIS 的令牌。必填。生产建议让 OAuth2 client-credentials 自动取，本项可留作人工兜底。
LIS_FHIR_TOKEN=REPLACE_WITH_LIS_ACCESS_TOKEN
# OAuth2 client-credentials（推荐）：配了下面三项就自动走「换 token 再带 bearer 调 FHIR」——
# 令牌自动缓存、提前 60 秒刷新，401 自动刷新并重试一次；与 LIS_FHIR_TOKEN 二选一即可。
LIS_FHIR_OAUTH_TOKEN_URL=https://lis-fhir.example-hospital.internal/auth/token
LIS_FHIR_OAUTH_CLIENT_ID=REPLACE_WITH_LIS_CLIENT_ID
LIS_FHIR_OAUTH_CLIENT_SECRET=REPLACE_WITH_LIS_CLIENT_SECRET
# 可选：授权范围。
LIS_FHIR_OAUTH_SCOPE=system/*.read system/*.write

# ---------- 危急值闭环 FHIR 出站（写 Task / AuditEvent / DiagnosticReport.note）----------
# 危急值闭环写入的 FHIR R4 端点。必填。填院内危急值闭环服务的地址。
# 本地联调时可改指本仓库自带的 FHIR 替身：node fhir-stub/server.ts（默认端口 9999，
# 即 http://127.0.0.1:9999/fhir/R4，可用 FHIR_STUB_PORT 覆盖）。
FHIR_BASE_URL=https://critical-fhir.example-hospital.internal/fhir/R4
# 访问该端点的令牌。必填。
FHIR_TOKEN=REPLACE_WITH_FHIR_ACCESS_TOKEN
# OAuth2 client-credentials（推荐）：与上面的 FHIR_TOKEN 二选一。
FHIR_OAUTH_TOKEN_URL=https://critical-fhir.example-hospital.internal/auth/token
FHIR_OAUTH_CLIENT_ID=REPLACE_WITH_CRITICAL_CLIENT_ID
FHIR_OAUTH_CLIENT_SECRET=REPLACE_WITH_CRITICAL_CLIENT_SECRET
# 可选：授权范围。
FHIR_OAUTH_SCOPE=system/*.read system/*.write

# ---------- 通知兜底 ----------
# WebSocket 推不到护士站大屏时的降级推送地址（院内 IM / OA webhook）。可留空。
NOTIFY_WEBHOOK_URL=

# ---------- 模型网关（OpenAI-compatible 单一协议）----------
# 只给「候选接收人」与「字段归因」两条辅助路径提供建议；不可达时自动降级到值班表规则。
MODELS_BASE_URL=https://models.example-hospital.internal/v1
MODELS_API_KEY=REPLACE_WITH_MODELS_API_KEY
MODELS_MODEL=gpt-4o-mini
MODELS_TIMEOUT_MS=8000

# ---------- 运行时 ----------
# 浏览器面板与 WebSocket 同端口监听。
HTTP_PORT=3000
# SQLite 数据目录（本地状态与审计链落地位置）。
DATA_DIR=./data
# 日志级别：trace / debug / info / warn / error。
LOG_LEVEL=info
# 优雅停机等待毫秒。
SHUTDOWN_TIMEOUT_MS=10000
